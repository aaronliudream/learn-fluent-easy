      "title": "A Let's talk",
      "lines": [
        { "role": "Mike", "text": "We have a new classroom.", "cn": "我们有一间新教室。" },
        { "role": "Sarah", "text": "Really? What's in the classroom?", "cn": "真的吗？教室里有什么？" },
