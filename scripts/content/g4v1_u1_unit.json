        { "role": "Sarah", "text": "It's so big!", "cn": "它好大啊！" },
        { "role": "Mike", "text": "The door is orange. The desks are green.", "cn": "门是橙色的。书桌是绿色的。" }
      ]
    },
    {
      "title": "B Let's talk",
      "lines": [
