  { "id": "fc_g6v2_read_01", "type": "reading_judge_TF", "unitId": "g6v2_u3", "passage": "Last weekend Mike went to a nature park with his family. They went there by car. In the morning they rowed a boat on the lake. In the afternoon Mike ate good food and took many pictures. He was very happy.", "subQuestions": [ { "stem": "Mike went to the park last weekend.", "options": ["T (相符)", "F (不相符)"], "answer": 0 }, { "stem": "They went there by bus.", "options": ["T (相符)", "F (不相符)"], "answer": 1 }, { "stem": "Mike took many pictures.", "options": ["T (相符)", "F (不相符)"], "answer": 0 } ], "vocab_domain": ["reading", "past"], "source": "real_exam", "source_ref": "真题·六下阅读改写" },
  { "id": "fc_g6v2_read_02", "type": "reading_judge_TF", "unitId": "g6v2_u1", "passage": "There are three people in my family. My father is tall and strong. My mother is shorter than my father. I am the youngest. I am 1.5 meters tall. My father is taller than me.", "subQuestions": [ { "stem": "The mother is shorter than the father.", "options": ["T (相符)", "F (不相符)"], "answer": 0 }, { "stem": "The writer is the oldest.", "options": ["T (相符)", "F (不相符)"], "answer": 1 }, { "stem": "The father is taller than the writer.", "options": ["T (相符)", "F (不相符)"], "answer": 0 } ], "vocab_domain": ["reading", "comparative"], "source": "real_exam", "source_ref": "真题·六下阅读改写" },
  { "id": "fc_g6v2_read_03", "type": "reading_judge_TF", "unitId": "g6v2_u3", "passage": "On National Day we went to Hainan. We visited my grandparents. We swam in the sea every day. We went fishing. My grandma cooked good food for us. We took many pictures. I was excited.", "subQuestions": [ { "stem": "We went to Hainan on National Day.", "options": ["T (相符)", "F (不相符)"], "answer": 0 }, { "stem": "We went swimming in a river.", "options": ["T (相符)", "F (不相符)"], "answer": 1 }, { "stem": "Grandma cooked good food for us.", "options": ["T (相符)", "F (不相符)"], "answer": 0 } ], "vocab_domain": ["reading", "past"], "source": "real_exam", "source_ref": "真题·六下阅读改写" },
  { "id": "fc_g6v2_read_04", "type": "reading_judge_TF", "unitId": "g6v2_u1", "passage": "Mike doesn't like washing his hands. His cousin Ted is one year younger than Mike. One day Mike looks at Ted's hands and says, “My hands are dirtier than yours!” Ted says, “Of course. You are older than I am.”", "subQuestions": [ { "stem": "Ted is younger than Mike.", "options": ["T (相符)", "F (不相符)"], "answer": 0 }, { "stem": "Mike likes washing his hands.", "options": ["T (相符)", "F (不相符)"], "answer": 1 }, { "stem": "Mike's hands are dirtier than Ted's.", "options": ["T (相符)", "F (不相符)"], "answer": 0 } ], "vocab_domain": ["reading", "comparative"], "source": "real_exam", "source_ref": "真题·六下阅读改写" },
  { "id": "fc_g6v2_read_05", "type": "reading_judge_TF", "unitId": "g6v2_u2", "passage": "Last Sunday Ben had a cold. He didn't go to school. He stayed at home and read books. His mother made soup for him. In the evening he felt better.", "subQuestions": [ { "stem": "Ben had a cold last Sunday.", "options": ["T (相符)", "F (不相符)"], "answer": 0 }, { "stem": "Ben went to school.", "options": ["T (相符)", "F (不相符)"], "answer": 1 }, { "stem": "His mother made soup for him.", "options": ["T (相符)", "F (不相符)"], "answer": 0 } ], "vocab_domain": ["reading", "past"], "source": "real_exam", "source_ref": "真题·六下阅读改写" },
  { "id": "fc_g6v2_read_06", "type": "reading_judge_TF", "unitId": "g6v2_u1", "passage": "Tom is taller than me, but I am stronger than him. He is 13 years old and I am 14. So I am older than Tom. We are good friends.", "subQuestions": [ { "stem": "Tom is taller than the writer.", "options": ["T (相符)", "F (不相符)"], "answer": 0 }, { "stem": "The writer is younger than Tom.", "options": ["T (相符)", "F (不相符)"], "answer": 1 }, { "stem": "They are good friends.", "options": ["T (相符)", "F (不相符)"], "answer": 0 } ], "vocab_domain": ["reading", "past"], "source": "real_exam", "source_ref": "真题·六下阅读改写" }
]
