# Copy this file to `.env` (and `.env.development` if needed) and fill in real values.
# Never commit the real .env files — only this template should be in Git.

# Supabase (publishable values, safe in client bundle but
# still kept out of the repo so rotation is easy).
VITE_SUPABASE_PROJECT_ID="your-project-ref"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-or-publishable-key"

# Stripe publishable key used by the embedded checkout.
# pk_test_... for sandbox, pk_live_... for production.
VITE_PAYMENTS_CLIENT_TOKEN="pk_test_xxx"

# ── Supabase Edge Function Secrets (set via CLI, NOT in this file) ──────────
# These are server-side secrets stored in Supabase, never in the browser bundle.
# Run once to configure:
#
#   npx supabase secrets set GOOGLE_AI_API_KEY=AIza...   # Google AI Studio key
#   npx supabase secrets set OPENAI_API_KEY=sk-...       # OpenAI key (voice/realtime only)
#
# Get your Google AI key at: https://aistudio.google.com/apikey  (free tier available)
# Get your OpenAI key at:    https://platform.openai.com/api-keys