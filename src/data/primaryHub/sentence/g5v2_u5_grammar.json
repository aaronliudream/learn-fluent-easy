          "_note": "扩充：用本单元 vocabulary 的物主代词 mine 造句，本单元课标句型。",
          "training": {
            "type": "fill_word",
            "promptZh": "「这本书是我的」该填哪个词？",
            "sentenceTemplate": "The book is ___.",
            "options": [
              { "text": "mine", "correct": true },
              { "text": "yours", "correct": false },
              { "text": "his", "correct": false }
            ],
            "explanationZh": "mine 是「我的」。yours（你的）、his（他的）也是真实的物主代词，但意思不对，要按中文选 mine。"
          }
        },
        {
          "id": "A4",
          "question": { "en": "Whose dog is it?", "zh": "这是谁的狗？" },
          "answer": null,
          "tag": "A 连一连",
          "_note": "扩充：The book is mine. 为本单元课标句型，非 dialogues 原句；前两句为课本原句。",
          "training": {
            "type": "match",
            "promptZh": "把英文句和中文意思连起来。",
            "pairs": [
              { "en": "The dog is yours.", "zh": "这只狗是你的。" },
              { "en": "It's his.", "zh": "是他的。" },
              { "en": "The book is mine.", "zh": "这本书是我的。" }
            ],
            "explanationZh": "这几句都是说东西「是谁的」，记住 mine 我的、yours 你的、his 他的。"
          }
        }
      ]
