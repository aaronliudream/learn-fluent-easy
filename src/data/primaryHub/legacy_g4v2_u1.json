          "text": "Forty-five students.",
          "cn": "45 个学生。"
        },
        {
          "role": "Visitor",
          "text": "Do you have a library?",
          "cn": "有图书馆吗？"
        },
        {
          "role": "Wu Binbin",
          "text": "Yes, we do. It's on the second floor.",
          "cn": "有，在二楼。"
