      "color": "blue",
      "estimatedMinutes": 4,
      "sentences": [
        {
          "id": "A1",
          "question": { "en": "I have a friend.", "zh": "我有一个朋友。" },
          "answer": { "en": "A boy or girl?", "zh": "男孩还是女孩？" },
          "tag": "A Let's talk",
          "training": {
            "type": "listening_response",
            "promptZh": "Amy 说「我有一个朋友」，对方该怎么回应？",
            "options": [
              { "text": "Thanks. Goodbye.", "correct": false },
              { "text": "I have a cat too.", "correct": false },
              { "text": "A boy or girl?", "correct": true }
