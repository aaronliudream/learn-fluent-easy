# Copy this file to `.env` (and `.env.development` if needed) and fill in real values.
# Never commit the real .env files — only this template should be in Git.

# Supabase / Lovable Cloud (publishable values, safe in client bundle but
# still kept out of the repo so rotation is easy).
VITE_SUPABASE_PROJECT_ID="your-project-ref"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-or-publishable-key"

# Stripe publishable key used by the embedded checkout.
# pk_test_... for sandbox, pk_live_... for production.
VITE_PAYMENTS_CLIENT_TOKEN="pk_test_xxx"