            "Might.",
            "Can't.",
            "Must."
          ],
          "answer_index": 3,
          "answer_text": "Must."
        },
        {
          "qid": "g9u8.l.06.q3",
          "volume": "9",
          "unit": "U8",
          "code": "g9u8.l.06",
          "stem": "Which words show we are less sure?",
          "options": [
            "Must.",
            "Might or could.",
            "Should.",
            "Can't."
          ],
          "answer_index": 1,
          "answer_text": "Might or could."
        },
