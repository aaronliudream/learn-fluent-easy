    {
      "title": "A Let's talk",
      "lines": [
        { "role": "Mike", "text": "Look at these! Are these carrots?", "cn": "看这些！这些是胡萝卜吗？" },
        { "role": "Sarah", "text": "No.", "cn": "不是。" },
        { "role": "Mike", "text": "What are these?", "cn": "这些是什么？" },
        { "role": "Sarah", "text": "They're tomatoes.", "cn": "是西红柿。" },
        { "role": "Mike", "text": "Try some! They're good.", "cn": "尝一个！很好吃。" },
        { "role": "Sarah", "text": "Thanks. Yum.", "cn": "谢谢。真好吃。" }
      ]
    },
    {
      "title": "B Let's talk",
      "lines": [
        { "role": "Mike", "text": "Wow! You have a lot of animals! What are those?", "cn": "哇！你有很多动物！那些是什么？" },
        { "role": "Sarah", "text": "Are they horses?", "cn": "它们是马吗？" },
        { "role": "Mike", "text": "No, they aren't. They're ducks.", "cn": "不是，是鸭子。" },
        { "role": "Sarah", "text": "How many horses do you have?", "cn": "你有多少匹马？" },
        { "role": "Mike", "text": "Seventeen.", "cn": "十七匹。" }
      ]
    }
  ],
