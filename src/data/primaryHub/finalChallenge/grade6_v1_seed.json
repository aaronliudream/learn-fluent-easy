  { "id": "fc_g6v1_read_01", "type": "reading_judge_TF", "unitId": "g6v1_u4", "passage": "I have a pen pal. His name is Tim. He lives in America. He likes diving and collecting stamps. His father is a scientist. Tim goes to school by subway every day.", "subQuestions": [ { "stem": "Tim lives in America.", "options": ["T (相符)", "F (不相符)"], "answer": 0 }, { "stem": "Tim's father is a doctor.", "options": ["T (相符)", "F (不相符)"], "answer": 1 }, { "stem": "Tim goes to school by subway.", "options": ["T (相符)", "F (不相符)"], "answer": 0 } ], "vocab_domain": ["reading", "hobby", "job"], "source": "real_exam", "source_ref": "真题·六上阅读改写" },
  { "id": "fc_g6v1_read_02", "type": "reading_judge_TF", "unitId": "g6v1_u1", "passage": "Mike goes to school on foot, because his home is near the school. His father is a doctor. He goes to work by car. His mother is a teacher. She goes to work by bus.", "subQuestions": [ { "stem": "Mike goes to school on foot.", "options": ["T (相符)", "F (不相符)"], "answer": 0 }, { "stem": "Mike's father is a teacher.", "options": ["T (相符)", "F (不相符)"], "answer": 1 }, { "stem": "His mother goes to work by bus.", "options": ["T (相符)", "F (不相符)"], "answer": 0 } ], "vocab_domain": ["reading", "transport", "job"], "source": "real_exam", "source_ref": "真题·六上阅读改写" },
  { "id": "fc_g6v1_read_03", "type": "reading_judge_TF", "unitId": "g6v1_u3", "passage": "Tomorrow is Saturday. We are going to be busy. My mother is going to buy some food. My father is going to visit my uncle. I am going to the bookstore to buy a comic book. In the evening we are going to see a film.", "subQuestions": [ { "stem": "Tomorrow is Saturday.", "options": ["T (相符)", "F (不相符)"], "answer": 0 }, { "stem": "Father is going to visit grandpa.", "options": ["T (相符)", "F (不相符)"], "answer": 1 }, { "stem": "In the evening they are going to see a film.", "options": ["T (相符)", "F (不相符)"], "answer": 0 } ], "vocab_domain": ["reading", "future"], "source": "real_exam", "source_ref": "真题·六上阅读改写" },
  { "id": "fc_g6v1_read_04", "type": "reading_judge_TF", "unitId": "g6v1_u5", "passage": "My name is Sam. I like playing football. I am good at it. I want to be a football player. My friend Daming likes basketball. He wants to work in a school.", "subQuestions": [ { "stem": "Sam likes playing football.", "options": ["T (相符)", "F (不相符)"], "answer": 0 }, { "stem": "Sam wants to be a teacher.", "options": ["T (相符)", "F (不相符)"], "answer": 1 }, { "stem": "Daming likes basketball.", "options": ["T (相符)", "F (不相符)"], "answer": 0 } ], "vocab_domain": ["reading", "hobby", "job"], "source": "real_exam", "source_ref": "真题·六上阅读改写" },
  { "id": "fc_g6v1_read_05", "type": "reading_judge_TF", "unitId": "g6v1_u6", "passage": "Today Tom is not happy. He failed the math test. His friend says, “Don't be sad. You should study hard.” Now Tom feels better.", "subQuestions": [ { "stem": "Tom is happy today.", "options": ["T (相符)", "F (不相符)"], "answer": 1 }, { "stem": "Tom failed the math test.", "options": ["T (相符)", "F (不相符)"], "answer": 0 }, { "stem": "His friend tells him to study hard.", "options": ["T (相符)", "F (不相符)"], "answer": 0 } ], "vocab_domain": ["reading", "feeling"], "source": "real_exam", "source_ref": "真题·六上阅读改写" },
  { "id": "fc_g6v1_read_06", "type": "reading_judge_TF", "unitId": "g6v1_u3", "passage": "Next week is the holiday. I am going to Beijing with my parents. We are going to visit the Great Wall. We are going to take many pictures. I am so excited.", "subQuestions": [ { "stem": "They are going to Beijing next week.", "options": ["T (相符)", "F (不相符)"], "answer": 0 }, { "stem": "They are going to visit the Great Wall.", "options": ["T (相符)", "F (不相符)"], "answer": 0 }, { "stem": "He is not excited.", "options": ["T (相符)", "F (不相符)"], "answer": 1 } ], "vocab_domain": ["reading", "future"], "source": "real_exam", "source_ref": "真题·六上阅读改写" }
]
