            "options": [
              { "text": "Blue his glasses are.", "correct": false },
              { "text": "His glasses are blue.", "correct": true },
              { "text": "He glasses blue is.", "correct": false }
            ],
            "explanationZh": "描述「他的眼镜是蓝色」用 His glasses are blue.，主语 + are + 颜色。"
          }
        },
        {
          "id": "B4",
          "question": { "en": "What's his name?", "zh": "他叫什么名字？" },
          "answer": { "en": "His name is Zhang Peng.", "zh": "他叫张鹏。" },
          "tag": "B Let's talk",
          "training": {
            "type": "listening_response",
            "promptZh": "你想知道他朋友叫什么，该问什么？",
            "options": [
              { "text": "Who he is?", "correct": false },
              { "text": "What's he?", "correct": false },
              { "text": "What's his name?", "correct": true }
