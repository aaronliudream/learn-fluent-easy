            "explanationZh": "听到「我有个朋友」，自然要问是男孩还是女孩，用 A boy or girl? 回应。"
          }
        },
        {
          "id": "A2",
          "question": { "en": "A boy. He's tall and strong.", "zh": "男孩。他又高又壮。" },
          "answer": { "en": "Who is he?", "zh": "他是谁？" },
          "tag": "A Let's talk",
          "training": {
            "type": "structure_transfer",
            "scenarioZh": "听完朋友的样子，想知道他到底是谁。",
            "promptZh": "「他是谁？」用英语怎么说？",
            "options": [
              { "text": "He who is?", "correct": false },
              { "text": "Who is he?", "correct": true },
              { "text": "Is who he?", "correct": false }
            ],
            "explanationZh": "问「他是谁」用 Who is he?，疑问词 Who 放最前面，再接 be 动词 is。"
          }
        },
        {
          "id": "A3",
          "question": { "en": "Is he friendly?", "zh": "他友好吗？" },
          "answer": { "en": "Yes, he is.", "zh": "是的，他很友好。" },
          "tag": "A Let's talk",
          "training": {
            "type": "sentence_choice",
            "promptZh": "「他友好吗？」用英语怎么说？",
            "options": [
              { "text": "Is he friendly?", "correct": true },
              { "text": "He friendly is?", "correct": false },
              { "text": "Friendly he is?", "correct": false }
            ],
            "explanationZh": "问「他友好吗」用一般疑问句 Is he + 形容词？be 动词 Is 提到句首。"
          }
        },
        {
          "id": "A4",
          "question": { "en": "My friend is quiet, but she's friendly.", "zh": "我朋友很安静，但很友好。" },
          "answer": null,
          "tag": "A Let's talk",
          "training": {
            "type": "fill_word",
            "promptZh": "「我朋友很安静，但很友好」选词填空。",
            "sentenceTemplate": "My friend is quiet, but she's ___.",
            "options": [
              { "text": "quiet", "correct": false },
              { "text": "tall", "correct": false },
              { "text": "friendly", "correct": true }
            ],
            "explanationZh": "友好用 friendly；but 表示转折，前后是安静和友好两种性格。"
          }
        }
      ]
    },
