          "training": {
            "type": "structure_transfer",
            "scenarioZh": "Sarah 想告诉同学，她爸爸在工厂工作。",
            "promptZh": "「他在工厂工作」用英语怎么说？",
            "options": [
              { "text": "He works in a factory.", "correct": true },
